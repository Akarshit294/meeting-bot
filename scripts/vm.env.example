# ONLY for the overnight build VM (internet through an HTTPS proxy). Copy the lines into .env there, and
# first run: python3 scripts/vm-proxy-forward.py 172.17.0.1 44337 &
BUILD_NETWORK=default
BUILD_NET=proxy
BUILD_HTTPS_PROXY=http://172.17.0.1:44337
BUILD_PROXY_CA_DIR=/tmp/proxyca
COMPOSE_BAKE=false
